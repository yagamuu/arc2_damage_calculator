{
  "name": "arc2_damage_calculator",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:temp": "vite build --outDir .ci-build",
    "lint": "eslint --ext .js,.vue,.ts src tests vite.config.ts vitest.config.ts playwright.config.ts",
    "test": "npm run test:unit",
    "test:unit": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:build": "npm run build:temp && E2E_SERVED_DIR=.ci-build playwright test"
  },
  "dependencies": {
    "@types/clone": "^0.1.30",
    "clone": "^2.1.2",
    "vue": "^2.7.16",
    "vue-class-component": "^7.2.3",
    "vue-property-decorator": "^8.4.1",
    "vuetify": "^2.6.10"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@typescript-eslint/eslint-plugin": "^2.26.0",
    "@typescript-eslint/parser": "^2.26.0",
    "@vitejs/plugin-vue2": "^2.3.4",
    "@vue/eslint-config-prettier": "^6.0.0",
    "@vue/eslint-config-typescript": "^5.0.2",
    "eslint": "^6.7.2",
    "eslint-plugin-prettier": "^3.1.1",
    "eslint-plugin-vue": "^6.2.2",
    "prettier": "^1.19.1",
    "typescript": "~3.8.3",
    "vite": "^7.3.8",
    "vitest": "^5.1.1"
  }
}

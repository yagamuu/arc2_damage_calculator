{
  "name": "arc2_damage_calculator",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:temp": "vite build --outDir .ci-build",
    "lint": "eslint .",
    "test": "npm run test:unit",
    "test:unit": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:build": "npm run build:temp && E2E_SERVED_DIR=.ci-build playwright test",
    "type-check": "vue-tsc --noEmit"
  },
  "dependencies": {
    "@types/clone": "^0.1.30",
    "clone": "^2.1.2",
    "vue": "^2.7.16",
    "vue-class-component": "^7.2.3",
    "vue-property-decorator": "^8.4.1",
    "vuetify": "^2.6.10"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.1",
    "@types/node": "^24.19.2",
    "@vitejs/plugin-vue2": "^2.3.4",
    "@vue/eslint-config-prettier": "^10.2.0",
    "@vue/eslint-config-typescript": "^14.9.0",
    "eslint": "^10.15.0",
    "eslint-plugin-vue": "^10.12.1",
    "prettier": "^3.10.1",
    "typescript": "~5.9.3",
    "vite": "^7.3.8",
    "vitest": "^5.1.1",
    "vue-tsc": "3.0.11"
  }
}
